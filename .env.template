PORT=3300

# The Ki.CL deployment that serves the design system, the API and this
# module's own server.
KICL_HOST_URL=https://dev.ki-cl.com

# Signed token that lets this app use KICL_HOST_URL from localhost. Personal
# and short-lived: use the one you were sent, and don't commit it. Leave it
# empty when the three URLs below point at services on this machine.
KICL_CLIENT_TOKEN=

# Cloudflare Turnstile site key, as in Ki.CL. A new anonymous session needs the
# check. This is dev.ki-cl.com's widget, which allows localhost. Against a
# local Ki.CL-back, use its key instead, or the test key
# 1x00000000000000000000AA, which always passes.
TURNSTILE_SITE_KEY=0x4AAAAAAFC1PtVlhJLRH6zl

# Set to use services running on this machine instead of KICL_HOST_URL. With
# all three set, nothing goes to KICL_HOST_URL and no token is needed.
# KICL_BACKEND_URL=http://localhost:3100
# KICL_DESIGN_URL=http://localhost:3200
# KICL_MOONSHOT_URL=http://localhost:3301

# Only for running Server/ yourself (make run.server).
# MOONSHOT_SERVER_PORT=3301
# ANTHROPIC_API_KEY=
# Only for a key that isn't scoped to a workspace.
# ANTHROPIC_WORKSPACE_ID=
# MOONSHOT_MODEL=claude-opus-5-5
# MOONSHOT_DAILY_ALLOWANCE=20
# Named as in Ki.CL-back, so a deploy reuses the same secrets.
# Without the URI, reviews are kept in memory.
# MONGODB_ATLAS_URI=
# Same as Ki.CL-back: test locally, production in production.
# MONGODB_DATABASE=test
